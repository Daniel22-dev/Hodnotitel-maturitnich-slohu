{
  "schema": "ghrab-data-manifest-v1",
  "appId": "essay-evaluator",
  "appVersion": "1.5.18",
  "manifestVersion": 3,
  "dataCategories": [
    "settings",
    "application-content",
    "diagnostics",
    "ai-prompts-and-results"
  ],
  "privacy": {
    "studentContentMayOccur": true,
    "telemetryContainsContent": false,
    "diagnosticsContainContentByDefault": false,
    "pseudonymisationIsNotAnonymisation": true
  },
  "stores": [
    {
      "kind": "localStorage",
      "category": "application-data",
      "patterns": [
        "ghrab.essay-evaluator.*"
      ],
      "sensitivity": "potentially-personal",
      "authority": "client",
      "clearOnEndWork": true
    },
    {
      "kind": "sessionStorage",
      "category": "session-data",
      "patterns": [
        "ghrab.essay-evaluator.ai.key.session.v1",
        "ghrab.essay-evaluator.legacy.BatchProgressSessionV078"
      ],
      "sensitivity": "confidential",
      "authority": "client",
      "clearOnEndWork": true
    },
    {
      "kind": "localStorage",
      "category": "credential",
      "patterns": [
        "ghrab.essay-evaluator.ai.key.local.v1"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "sessionStorage",
      "category": "credential",
      "patterns": [
        "ghrab.essay-evaluator.ai.key.session.v1"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "cacheStorage",
      "category": "application-cache",
      "patterns": [
        "ghrab-essay-evaluator-v*",
        "essay-evaluator*"
      ],
      "sensitivity": "non-content-cache",
      "authority": "client",
      "clearOnEndWork": false
    }
  ],
  "retention": {
    "defaultDays": 30,
    "sessionEndsOnLogout": true,
    "serverLogsDays": 30,
    "clientSensitiveDays": 30,
    "clientEnforced": true
  },
  "export": {
    "supported": true,
    "requiresExplicitUserAction": true,
    "includesSecrets": false,
    "envelopeSchema": "ghrab-artifact-envelope-v1",
    "artifactTypes": [],
    "nativeFormats": [
      "docx",
      "pdf",
      "csv",
      "zip"
    ]
  },
  "deletion": {
    "supported": true,
    "clientVerified": true,
    "serverEndpoint": "data/essay-evaluator",
    "serverVerified": false
  },
  "sharedDevice": {
    "supported": true,
    "defaultInSchoolProfile": true,
    "control": "endSensitiveWork()"
  },
  "storageNamespace": {
    "schema": "ghrab-storage-namespace-v1",
    "prefix": "ghrab.essay-evaluator.",
    "migrationId": "p2-storage-namespace-v1",
    "backup": "metadata",
    "rollbackSupported": true
  },
  "import": {
    "supported": false,
    "artifactTypes": [],
    "acceptsLegacyJson": false,
    "checksumRequiredForEnvelope": true
  }
}
