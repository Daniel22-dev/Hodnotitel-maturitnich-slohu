{
  "schema": "ghrab-data-manifest-v1",
  "appId": "essay-evaluator",
  "appVersion": "1.5.21",
  "manifestVersion": 4,
  "dataCategories": [
    "settings",
    "application-content",
    "diagnostics",
    "ai-prompts-and-results",
    "credentials",
    "suite-lifecycle"
  ],
  "privacy": {
    "studentContentMayOccur": true,
    "telemetryContainsContent": false,
    "diagnosticsContainContentByDefault": false,
    "pseudonymisationIsNotAnonymisation": true
  },
  "stores": [
    {
      "kind": "localStorage",
      "category": "application-content",
      "patterns": [
        "ghrab.essay-evaluator.state.v1",
        "ghrab.essay-evaluator.tasks.v1",
        "ghrab.essay-evaluator.history.v1",
        "ghrab.essay-evaluator.legacy.SensitiveSaveV073",
        "ghrab.essay-evaluator.legacy.BatchProgressLocalV078",
        "ghrab.essay-evaluator.legacy.StateV100",
        "ghrab.essay-evaluator.legacy.StateV07*"
      ],
      "sensitivity": "potentially-personal",
      "authority": "client",
      "clearOnEndWork": true
    },
    {
      "kind": "sessionStorage",
      "category": "application-content",
      "patterns": [
        "maturitniHodnotitelTasksSessionV117",
        "maturitniHodnotitelBatchProgressSessionV078",
        "ghrab.essay-evaluator.legacy.TasksSessionV117",
        "ghrab.essay-evaluator.legacy.BatchProgressSessionV078"
      ],
      "sensitivity": "confidential",
      "authority": "client",
      "clearOnEndWork": true
    },
    {
      "kind": "localStorage",
      "category": "credential",
      "patterns": [
        "ghrab.essay-evaluator.ai.key.local.v1"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "sessionStorage",
      "category": "credential",
      "patterns": [
        "ghrab.essay-evaluator.ai.key.session.v1"
      ],
      "sensitivity": "secret",
      "authority": "client-direct-mode-only",
      "clearOnEndWork": true
    },
    {
      "kind": "localStorage",
      "category": "settings",
      "patterns": [
        "ghrab.essay-evaluator.theme.v1",
        "ghrab.essay-evaluator.ai.model.v1",
        "ghrab.essay-evaluator.legacy.PrivacyAckV071"
      ],
      "sensitivity": "non-personal-setting",
      "authority": "client",
      "clearOnEndWork": false
    },
    {
      "kind": "localStorage",
      "category": "diagnostics",
      "patterns": [
        "ghrab.essay-evaluator.legacy.DailyUsageV110"
      ],
      "sensitivity": "non-content-metrics",
      "authority": "client",
      "clearOnEndWork": false
    },
    {
      "kind": "localStorage",
      "category": "suite-lifecycle",
      "patterns": [
        "ghrab.essay-evaluator.suite-session-observed.v1",
        "ghrab.essay-evaluator.suite-session-cleanup-complete.v1",
        "ghrab.essay-evaluator.suite-session-seen.v1",
        "ghrab.essay-evaluator.migration.p2-storage-namespace-v1.done",
        "ghrab.essay-evaluator.migration.p2-storage-namespace-v1.backup"
      ],
      "sensitivity": "non-content-security-state",
      "authority": "client-and-platform",
      "clearOnEndWork": false
    },
    {
      "kind": "localStorage",
      "category": "suite-lifecycle",
      "patterns": [
        "ghrab.platform.suite-session-generation.v1"
      ],
      "sensitivity": "non-content-security-state",
      "authority": "platform-shared-not-owned-by-app",
      "clearOnEndWork": false
    },
    {
      "kind": "localStorage",
      "category": "manual-settings",
      "patterns": [
        "ghrab-manual-progress-essay-evaluator-*",
        "ghrab-manual-theme"
      ],
      "sensitivity": "non-personal-setting",
      "authority": "client",
      "clearOnEndWork": false
    },
    {
      "kind": "cacheStorage",
      "category": "application-cache",
      "patterns": [
        "ghrab-essay-evaluator-v*",
        "essay-evaluator*"
      ],
      "sensitivity": "non-content-cache",
      "authority": "client",
      "clearOnEndWork": false
    }
  ],
  "retention": {
    "defaultDays": 30,
    "sessionEndsOnLogout": true,
    "serverLogsDays": 30,
    "clientSensitiveDays": 30,
    "clientEnforced": true
  },
  "export": {
    "supported": true,
    "requiresExplicitUserAction": true,
    "includesSecrets": false,
    "envelopeSchema": "ghrab-artifact-envelope-v1",
    "artifactTypes": [],
    "nativeFormats": [
      "docx",
      "pdf",
      "csv",
      "zip"
    ]
  },
  "deletion": {
    "supported": true,
    "clientVerified": true,
    "serverEndpoint": "data/essay-evaluator",
    "serverVerified": false
  },
  "sharedDevice": {
    "supported": true,
    "defaultInSchoolProfile": true,
    "control": "ghrab-suite-session-v1 + endSensitiveWork()",
    "suiteSessionContract": "ghrab-suite-session-v1",
    "acknowledgementKey": "ghrab.essay-evaluator.suite-session-seen.v1",
    "observedEvidenceKey": "ghrab.essay-evaluator.suite-session-observed.v1",
    "cleanupEvidenceKey": "ghrab.essay-evaluator.suite-session-cleanup-complete.v1"
  },
  "storageNamespace": {
    "schema": "ghrab-storage-namespace-v1",
    "prefix": "ghrab.essay-evaluator.",
    "migrationId": "p2-storage-namespace-v1",
    "backup": "metadata",
    "rollbackSupported": true
  },
  "import": {
    "supported": false,
    "artifactTypes": [],
    "acceptsLegacyJson": false,
    "checksumRequiredForEnvelope": true
  }
}
